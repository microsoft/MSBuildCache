<Project>
  <PropertyGroup>
    <MSBuildCacheAssembly Condition="'$(MSBuildRuntimeType)' != 'Core'">$(MSBuildThisFileDirectory)net472\Microsoft.MSBuildCache.AzurePipelines.dll</MSBuildCacheAssembly>
    <MSBuildCacheAssembly Condition="'$(MSBuildRuntimeType)' == 'Core'">$(MSBuildThisFileDirectory)net10.0\Microsoft.MSBuildCache.AzurePipelines.dll</MSBuildCacheAssembly>
    <MSBuildCacheAssembly Condition="'$(MSBuildRuntimeType)' == 'Core' and $([System.Environment]::Version.Major) &gt;= 11">$(MSBuildThisFileDirectory)net11.0\Microsoft.MSBuildCache.AzurePipelines.dll</MSBuildCacheAssembly>
  </PropertyGroup>

  <Import Project="Microsoft.MSBuildCache.Common.props" />
</Project>